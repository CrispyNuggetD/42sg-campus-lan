{
  "manifest_version": 3,
  "name": "LAN42 \u2014 save this avatar",
  "version": "1.3.0",
  "description": "Save explicitly prepared avatars and close only an approved LAN42 sign-in completion tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "Save this displayed photo to LAN42",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cdn.intra.42.fr/*"
      ],
      "js": [
        "capture.js",
        "automatic.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:31415/signin-complete*"
      ],
      "js": [
        "signin-close.js"
      ],
      "run_at": "document_start"
    }
  ]
}
